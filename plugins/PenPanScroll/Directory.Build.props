<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OtdDirectory Condition="'$(OtdDirectory)' == ''">$(MSBuildThisFileDirectory)../../OpenTabletDriver.Desktop/bin/Release/net10.0</OtdDirectory>
  </PropertyGroup>
</Project>
